+    if (m.isMeshBasicMaterial) {
+      e.emissive = true;
+      if (m.transparent) e.transparent = true;
+      if (m.blending === THREE.AdditiveBlending) e.additive = true;
+      if (m.opacity < 1) e.opacity = m.opacity;
