+    vec4 ga = textureGrad(facadeAtlas, guv, gx, gy);
+    vec4 gm = textureGrad(facadeMask, guv, gx, gy);
+    fa.rgb = mix(fa.rgb, ga.rgb, ga.a);
+    fm = mix(fm, gm, ga.a);
+    int gi = int(gc + 0.5);
+    if (ga.a > 0.5) {
+      fLit = fCellLit[gi] < 0.0 ? litRatio : fCellLit[gi];
+      fWin = fCellWin[gi];
+      fOff = 0.0;
+    }
+  }
+}
+fGlass = fm.b;
+fGloss = fm.g;
+fSign = fm.a;
+// Per building: brightness, a warm or cool cast (walls only), trim colour.
+float fh1 = fHash(vec3(vSeed, 3.0, 1.0)), fh2 = fHash(vec3(vSeed, 9.0, 5.0)), fh3 = fHash(vec3(vSeed, 41.0, 7.0));
+vec3 fTint = (0.86 + 0.28 * fh1) * mix(vec3(1.06, 0.98, 0.92), vec3(0.94, 0.99, 1.06), fh2);
+vec3 fTrim = fTrimSet[ft] < 0.5 ? TRIM_RES[int(fh3 * 7.999)] : TRIM_MET[int(fh3 * 3.999)];
+vec3 fCol = fa.rgb * mix(fTint, vec3(1.0), clamp(fm.r + fm.b, 0.0, 1.0));
