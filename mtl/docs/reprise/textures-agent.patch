 /**
- * One material for every facade in the city: an atlas row per facade type,
- * tiled per bay and per floor in the shader, with lit windows chosen per
- * window from a hash — so ten thousand buildings cost one draw call per chunk
- * and no two streets light up alike.
+ * Ground shader patch: large-scale tone variation in world metres (and dry,
+ * yellowed patches on lawns), and for asphalt the wet look — darker, glossy,
+ * mirror puddles — driven by one shared `wet` uniform, 0 by day, 1 at night.
+ */
+function groundPatch(m, macro, o) {
+  if (!macro || !m.map) return;
+  const wet = !!o.wetMap;
+  const uniforms = {
+    macroMap: { value: macro },
+    macroK: { value: o.strength ?? 0.2 },
+    macroDry: { value: o.dry || 0 },
+    tileMetres: { value: m.map.userData.metres || 1 },
+  };
+  if (wet) {
+    uniforms.wetMap = { value: o.wetMap };
+    uniforms.wet = o.wet;
+    uniforms.wetRough = { value: 0.55 };
+    materialTextures.set(m, { ...(materialTextures.get(m) || {}), wet: o.wetMap });
+  }
+  materialTextures.set(m, { ...(materialTextures.get(m) || {}), macro });
+  m.customProgramCacheKey = () => (wet ? 'ground-wet-v1' : 'ground-v1');
+  m.onBeforeCompile = (shader) => {
+    Object.assign(shader.uniforms, uniforms);
+    shader.fragmentShader = shader.fragmentShader
+      .replace('#include <common>', `#include <common>
+uniform sampler2D macroMap;
+uniform float macroK;
+uniform float macroDry;
+uniform float tileMetres;
+${wet ? 'uniform sampler2D wetMap;\nuniform float wet;\nuniform float wetRough;\nvec3 gWet = vec3(1.0, 0.6, 0.0);' : ''}`)
+      .replace('#include <map_fragment>', `#include <map_fragment>
+{
+  vec2 wUv = vMapUv * tileMetres;           // world metres
+  vec3 mA = texture2D(macroMap, wUv / 97.0).rgb;
+  float mB = texture2D(macroMap, wUv / 23.0 + vec2(0.37, 0.61)).g;
+  diffuseColor.rgb *= 1.0 + macroK * ((mA.r - 0.5) * 1.3 + (mB - 0.5) * 0.7);
+  diffuseColor.rgb = mix(diffuseColor.rgb, diffuseColor.rgb * vec3(1.22, 1.08, 0.62), macroDry * smoothstep(0.5, 0.78, mA.g));
+${wet ? `  gWet = texture2D(wetMap, vMapUv).rgb;
+  diffuseColor.rgb *= 1.0 - wet * (0.22 + 0.35 * gWet.b);` : ''}
+}`);
+    if (wet) {
+      shader.fragmentShader = shader.fragmentShader.replace('#include <roughnessmap_fragment>',
+        'float roughnessFactor = mix(roughness * (0.7 + 0.3 * gWet.r), wetRough * gWet.g, wet);');
+    }
+  };
+}
+
