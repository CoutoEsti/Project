+// The game's textures for Unity: the same generators as the page, run in
+// headless Chromium (they need a canvas), written as PNG, with a
+// materials.json that maps every material name to its files.
+//
+//   node mtl/tools/textures.mjs              → mtl/export/textures/
+//   node mtl/tools/textures.mjs --out DIR
+//
+// Also prints what each texture cost to make and its GPU memory. PNGs are
+// encoded here from the raw pixels: a canvas would lose the colour of every
+// pixel whose alpha is 0 (the facade atlas has some).
+
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { fileURLToPath } from 'node:url';
+import { serve } from './lib/serve.mjs';
+import { loadPlaywright } from './lib/playwright.mjs';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const args = process.argv.slice(2);
+const OUT = path.resolve(args.includes('--out') ? args[args.indexOf('--out') + 1] : path.join(ROOT, 'export', 'textures'));
+
+/** Runs in the page: builds the materials, returns their textures as raw RGBA. */
+async function collect() {
+  const THREE = await import('/vendor/three.module.min.js');
+  const T = await import('/src/world/textures.js');
+  const { createMaterials, materialTextures } = await import('/src/world/materials.js');
+  const t0 = performance.now();
+  const M = createMaterials(THREE);
+  const total = performance.now() - t0;
+
+  const files = new Map();                  // texture → file entry
+  const b64 = (u8) => {
+    let s = '';
+    for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000));
+    return btoa(s);
+  };
+  const file = (tex) => {
+    if (!tex) return null;
+    if (files.has(tex)) return files.get(tex).name;
+    const img = tex.image;
+    let data, w, h;
+    if (img.data) {
+      ({ width: w, height: h } = img);
+      data = new Uint8Array(img.data.buffer, img.data.byteOffset, img.data.byteLength);
+    } else {
+      w = img.width; h = img.height;
+      data = new Uint8Array(img.getContext('2d').getImageData(0, 0, w, h).data.buffer);
+    }
+    const name = (tex.userData.name || `texture_${files.size}`).replace(/[^a-zA-Z0-9_-]+/g, '_') + '.png';
+    const mips = tex.generateMipmaps !== false && tex.minFilter !== THREE.LinearFilter && tex.minFilter !== THREE.NearestFilter;
+    files.set(tex, {
+      name, w, h, data: b64(data), srgb: tex.colorSpace === THREE.SRGBColorSpace,
+      bytes: Math.round(w * h * 4 * (mips ? 4 / 3 : 1)),
+      metres: tex.userData.metres ? [tex.userData.metres, tex.userData.metresV || tex.userData.metres] : null,
+    });
+    return name;
+  };
+  const hex = (c) => '#' + c.getHexString();
+  const materials = {};
+  for (const m of Object.values(M)) {
+    if (!m || !m.isMaterial || materials[m.name]) continue;
+    const tx = materialTextures.get(m) || {};
+    const e = {
+      shader: m.isMeshStandardMaterial ? 'standard' : 'unlit',
+      color: hex(m.color),
+      colorLinear: m.color.toArray().map((v) => +v.toFixed(4)),
+    };
+    if (m.isMeshStandardMaterial) Object.assign(e, { roughness: m.roughness, metalness: m.metalness });
+    if (m.userData.flat) e.flat = m.userData.flat;
+    if (m.userData.metres) e.metres = m.userData.metres;
+    const textures = {};
+    for (const [k, t] of Object.entries({ albedo: tx.map, wet: tx.wet, mask: tx.mask, alpha: tx.alpha, bump: tx.bump, macro: tx.macro })) {
+      const f = file(t);
+      if (f) textures[k] = f;
+    }
