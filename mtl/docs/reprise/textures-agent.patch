     shader.fragmentShader = shader.fragmentShader
       .replace('#include <common>', `#include <common>
 uniform sampler2D facadeAtlas;
-uniform float facadeRows;
+uniform sampler2D facadeMask;
 uniform float night;
 uniform float litRatio;
+uniform float fShopA[${nT}];
+uniform float fShopB[${nT}];
+uniform float fShopC[${nT}];
+uniform float fShopP[${nT}];
+uniform float fDoor[${nT}];
+uniform float fDoorP[${nT}];
+uniform float fOffice[${nT}];
+uniform float fTrimSet[${nT}];
+uniform float fCellLit[${nC}];
+uniform vec2 fCellWin[${nC}];
 varying vec2 vFacadeUv;
-varying float vFacade;
-varying float vSeed;
+// Flat: the hashes below are chaotic, and an interpolated constant is not
+// quite constant — every pixel would pick its own colour.
+flat varying float vFacade;
+flat varying float vSeed;
 float fHash(vec3 p) {
   p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
   p *= 17.0;
   return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
 }
+// Atlas cell + position in the bay (0..1, y up) → texture coordinates. Row 0
+// of the data is the top of the painted canvas.
+vec2 fAtlasUv(float c, vec2 ff) {
+  float col = mod(c, ${f(cols)}), row = floor(c / ${f(cols)} + 0.001);
+  return vec2(col * ${f(cell)} + ${f(pad)} + ff.x * ${f(cell - 2 * pad)},
+              row * ${f(cell)} + ${f(pad)} + (1.0 - ff.y) * ${f(cell - 2 * pad)}) / ${f(size)};
+}
+const vec3 TRIM_RES[8] = vec3[8](vec3(0.82, 0.8, 0.74), vec3(0.025), vec3(0.04, 0.14, 0.07), vec3(0.24, 0.035, 0.03),
+  vec3(0.03, 0.06, 0.17), vec3(0.64, 0.54, 0.38), vec3(0.04, 0.19, 0.21), vec3(0.3, 0.3, 0.29));
+const vec3 TRIM_MET[4] = vec3[4](vec3(0.52, 0.54, 0.56), vec3(0.07, 0.06, 0.05), vec3(0.03), vec3(0.3, 0.31, 0.32));
 float fGlass = 0.0;
-vec2 fCell = vec2(0.0);`)
+float fGloss = 0.0;
+float fSign = 0.0;
+float fBlind = 0.0;
+float fLit = 0.36;
+float fOff = 0.0;
+vec2 fWin = vec2(0.0);
+vec2 fFrac = vec2(0.0);
+vec2 fCell = vec2(0.0);
+vec3 fAlb = vec3(0.0);`)
       .replace('#include <map_fragment>', `
 fCell = floor(vFacadeUv);
-vec2 ff = fract(vFacadeUv);
-vec2 auv = vec2(ff.x, (facadeRows - vFacade - 1.0 + ff.y) / facadeRows);
-vec2 gx = dFdx(vFacadeUv) * vec2(1.0, 1.0 / facadeRows);
-vec2 gy = dFdy(vFacadeUv) * vec2(1.0, 1.0 / facadeRows);
-vec4 fs = textureGrad(facadeAtlas, auv, gx, gy);
-fGlass = fs.a;
-diffuseColor.rgb *= fs.rgb * (0.88 + 0.24 * fHash(vec3(vSeed, 3.0, 1.0)));`)
+fFrac = fract(vFacadeUv);
+int ft = int(vFacade + 0.5);
+float fk = ${f(cell - 2 * pad)} / ${f(size)};
+vec2 gx = dFdx(vFacadeUv) * fk, gy = dFdy(vFacadeUv) * fk;
+vec4 fa = textureGrad(facadeAtlas, fAtlasUv(vFacade, fFrac), gx, gy);
+vec4 fm = textureGrad(facadeMask, fAtlasUv(vFacade, fFrac), gx, gy);
+fLit = litRatio;
+fOff = fOffice[ft];
+fWin = fCellWin[ft];
+// Floor 0: shopfronts for some buildings, doors in some bays.
+if (abs(fCell.y) < 0.5) {
+  float gc = -1.0;
+  if (fHash(vec3(vSeed, 17.0, 3.0)) < fShopP[ft]) {
+    float pick = fHash(vec3(vSeed, 5.0, 29.0));
+    gc = pick < 0.34 ? fShopA[ft] : (pick < 0.67 ? fShopB[ft] : fShopC[ft]);
+  } else if (fHash(vec3(fCell.x, vSeed, 23.0)) < fDoorP[ft]) {
+    gc = fDoor[ft];
+  }
+  if (gc >= 0.0) {
