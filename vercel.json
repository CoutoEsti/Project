{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/hop/:path*", "destination": "/hop/:path*" },
    { "source": "/", "destination": "/mtl/index.html" },
    { "source": "/:path*", "destination": "/mtl/:path*" }
  ],
  "headers": [
    {
      "source": "/(hop|mtl)/vendor/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(hop|mtl)/models/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(hop|mtl)/data/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
